country":"RU","description":"Переселение на Волгу","source":"user"},{"personId":"cmv2japmb001n6h7d5gwqkakx","year":1845,"place":"Одесса","country":"UA","description":"Переезд к Чёрному морю","source":"user"},{"personId":"cmv2japmd001o6h7don82xyzd","year":1844,"place":"Одесса","country":"UA","description":"Переезд в Одессу","source":"user"},{"personId":"cmv2japmq001u6h7d668mkg0s","year":1870,"place":"Одесса","country":"UA","description":"Свадьба в Одессе","source":"user"},{"personId":"cmv2japmx001y6h7dbjz5gb5b","year":1898,"place":"Омск","country":"RU","description":"Переселение в Сибирь","source":"user"},{"personId":"cmv2japmz001z6h7dixyoqfdv","year":1898,"place":"Омск","country":"RU","description":"Переселение в Сибирь","source":"user"},{"personId":"cmv2japn700246h7dr1t6ey9y","year":1903,"place":"Lincoln","country":"US","description":"Эмиграция в Небраску","source":"user"},{"personId":"cmv2japni00286h7dnc9d3fck","year":1941,"place":"Караганда","country":"KZ","description":"Депортация в Казахстан","source":"user"},{"personId":"cmv2japnk00296h7ddh2phkcx","year":1941,"place":"Караганда","country":"KZ","description":"Депортация в Казахстан","source":"user"},{"personId":"cmv2japns002e6h7dwmiatmbg","year":1941,"place":"Караганда","country":"KZ","description":"Депортация в Казахстан","source":"user"},{"personId":"cmv2japny002f6h7dpgj6whef","year":1952,"place":"Караганда","country":"KZ","description":"Работа учительницей","source":"user"},{"personId":"cmv2japo8002k6h7dzymz58gb","year":1992,"place":"Köln","country":"DE","description":"Переезд в Германию","source":"user"},{"personId":"cmv2japoa002l6h7drnsjpzeb","year":1978,"place":"Караганда","country":"KZ","description":"Распределение после института","source":"user"},{"personId":"cmv2japoa002l6h7drnsjpzeb","year":1992,"place":"Köln","country":"DE","description":"Переезд в Германию","source":"user"},{"personId":"cmv2japos002r6h7dcc68v2uh","year":1994,"place":"Hannover","country":"DE","description":"Переезд в Германию","source":"user"},{"personId":"cmv2japoz002v6h7dy5z29fnu","year":1992,"place":"Köln","country":"DE","description":"Переезд в Германию","source":"user"},{"personId":"cmv2japoz002v6h7dy5z29fnu","year":2015,"place":"Zug","country":"CH","description":"Работа в Швейцарии","source":"user"},{"personId":"cmv2japp6002w6h7do901egnt","year":2010,"place":"Köln","country":"DE","description":"Учёба в Кёльне","source":"user"},{"personId":"cmv2japp6002w6h7do901egnt","year":2015,"place":"Zug","country":"CH","description":"Переезд в Цуг","source":"user"},{"personId":"cmv2jappo00336h7dixtah89u","year":2015,"place":"Zug","country":"CH","description":"Переезд в Цуг","source":"user"}],"stories":[{"title":"Мельница под Берном","body":"Со слов бабушки Айгуль, которая слышала это от свёкра: первый Мюллер, которого кто-то помнит по имени, держал мельницу у реки Аре под Берном. Записей не осталось, только фамилия и рассказ о большом наводнении, после которого семья ушла в Пфальц.","bodyLang":"ru","visibility":"family","chapter":"Origins","personId":"cmv2japk0000r6h7d4k3ktp55","createdAt":"2026-08-11T15:14:18.164Z","daysAgo":60},{"title":"Дорога на Волгу","body":"В 1766 году Георг с женой и четырёхлетним Фридрихом подписали манифест императрицы и поехали в Россию. Через Любек морем, потом по рекам. В семье говорили, что Маргарета везла с собой только сундук с семенами и Библию.","bodyLang":"ru","visibility":"family","chapter":"Leaving home","personId":"cmv2japl500166h7ds60cb4xa","createdAt":"2026-08-16T15:14:18.176Z","daysAgo":55},{"title":"Колония на Волге","body":"Генрих родился уже в колонии под Саратовом. Дома говорили по-немецки, а на базаре — по-русски. Сохранилась его фраза, которую потом повторяли все дети: «Хлеб растёт там, где ты его посеял».","bodyLang":"ru","visibility":"family","chapter":"Childhood","personId":"cmv2japm3001j6h7ddogapmmi","createdAt":"2026-08-21T15:14:18.183Z","daysAgo":50},{"title":"Полька из Кракова","body":"Зофья приехала в Одессу работать в лавке у дяди и встретила там Андреаса. Её родные были против брака с немцем-колонистом, и венчались они почти без гостей. Кольцо Зофьи до сих пор хранится у тёти Елены.","bodyLang":"ru","visibility":"family","chapter":"Love","personId":"cmv2japmd001o6h7don82xyzd","createdAt":"2026-08-26T15:14:18.191Z","daysAgo":45},{"title":"Сибирский хутор","body":"Карл с Натальей переселились под Омск, когда там раздавали землю. Первую зиму жили в землянке. К 1910 году у них было двенадцать коров и маслобойня, масло возили на станцию.","bodyLang":"ru","visibility":"family","chapter":"Work","personId":"cmv2japmx001y6h7dbjz5gb5b","createdAt":"2026-09-05T15:14:18.201Z","daysAgo":35},{"title":"Как прадед попал в Караганду","body":"В сорок первом году всю семью Мюллеров из Омска отправили в Казахстан. Виктору было тринадцать, он помнил вагон и степь. В Караганде он работал на шахте с пятнадцати лет и всю жизнь не любил говорить о тех годах.","bodyLang":"ru","visibility":"family","chapter":"Hard years","personId":"cmv2japns002e6h7dwmiatmbg","createdAt":"2026-09-10T15:14:18.205Z","daysAgo":30},{"title":"Учительница из Алматы","body":"Айгуль приехала в Караганду по распределению преподавать русский язык. Виктор пришёл в вечернюю школу за аттестатом — и через год они поженились. Бабушка смеялась, что это был её единственный ученик, который так и не сдал диктант.","bodyLang":"ru","visibility":"family","chapter":"Love","personId":"cmv2japny002f6h7dpgj6whef","createdAt":"2026-09-15T15:14:18.209Z","daysAgo":25},{"title":"Девяносто второй","body":"Мы уезжали в Германию с тремя чемоданами и коробкой фотографий. На вокзале в Караганде отец сказал: «Двести лет назад мы ехали сюда, теперь едем обратно». В Кёльне первый год жили в общежитии для переселенцев.","bodyLang":"ru","visibility":"family","chapter":"Leaving home","personId":"cmv2japo8002k6h7dzymz58gb","createdAt":"2026-09-20T15:14:18.214Z","daysAgo":20},{"title":"Миланская бабушка","body":"Джулия приехала в Кёльн учиться и познакомилась с Михаэлем в очереди в столовой. Её бабушка из Милана до сих пор присылает на Рождество панеттоне и спрашивает, когда мы приедем.","bodyLang":"ru","visibility":"family","chapter":"Love","personId":"cmv2japp6002w6h7do901egnt","createdAt":"2026-09-30T15:14:18.240Z","daysAgo":10},{"title":"Цуг и наши дети","body":"В 2015 году мы переехали в Цуг. Леону было четыре года, Софии ещё не было. Получается, что спустя почти четыреста лет семья вернулась туда, откуда начиналась, — в Швейцарию, в сотне километров от той мельницы под Берном.","bodyLang":"ru","visibility":"family","chapter":"The next generation","personId":"cmv2japoz002v6h7dy5z29fnu","createdAt":"2026-10-05T15:14:18.244Z","daysAgo":5},{"title":"Брат, уехавший в Небраску","body":"Младший брат прадеда Карла, Иоганн, в 1903 году уплыл в Америку и осел в Линкольне, штат Небраска, где уже жили другие волжские немцы. Последнее письмо от него пришло в 1938 году. Его потомков мы так и не нашли.","bodyLang":"ru","visibility":"family","chapter":"Leaving home","personId":"cmv2japn700246h7dr1t6ey9y","createdAt":"2026-08-31T15:14:18.198Z","daysAgo":40}],"crests":[],"places":[{"id":"cmv2japi300036h7dqxs7ensm","key":"bern|CH","lat":46.948,"lng":7.447,"country":"CH"},{"id":"cmv2japi700046h7dvpkpkrhu","key":"thun|CH","lat":46.758,"lng":7.628,"country":"CH"},{"id":"cmv2japi900056h7dueekaxlp","key":"basel|CH","lat":47.559,"lng":7.588,"country":"CH"},{"id":"cmv2japic00066h7da2mmna79","key":"zug|CH","lat":47.166,"lng":8.515,"country":"CH"},{"id":"cmv2japif00076h7dw9bk3h7h","key":"mannheim|DE","lat":49.487,"lng":8.466,"country":"DE"},{"id":"cmv2japik00086h7dam5xxxf1","key":"heidelberg|DE","lat":49.398,"lng":8.672,"country":"DE"},{"id":"cmv2japim00096h7dgwg09djj","key":"worms|DE","lat":49.634,"lng":8.35,"country":"DE"},{"id":"cmv2japip000a6h7df5jy5zzk","key":"darmstadt|DE","lat":49.872,"lng":8.651,"country":"DE"},{"id":"cmv2japir000b6h7dv4ubh57w","key":"frankfurt am main|DE","lat":50.11,"lng":8.682,"country":"DE"},{"id":"cmv2japit000c6h7dqq30icnu","key":"köln|DE","l