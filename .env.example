# ---------------------------------------------------------------
# Treename 2.0 — environment variables
# Copy to .env and fill in. Everything except DATABASE_URL and
# APP_URL is optional in development: the app falls back to safe
# defaults (links printed to the console, AI off, payments off).
# ---------------------------------------------------------------

# Public URL of the app (no trailing slash)
APP_URL="http://localhost:3000"

# Database: PostgreSQL.
# On Vercel, adding Neon (Storage tab) sets both variables automatically.
# Locally, e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treename"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/treename"

# Where data is stored, shown on the website and privacy page:
# "eu" (default, e.g. Vercel + Neon Frankfurt) or "ch" (only if database, files and AI really run in Switzerland)
DATA_REGION="eu"

# --- AI: story writing and fact extraction (Anthropic Claude API) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- Speech-to-text for voice answers (OpenAI-compatible transcription endpoint) ---
TRANSCRIBE_API_KEY=""
TRANSCRIBE_URL="https://api.openai.com/v1/audio/transcriptions"
TRANSCRIBE_MODEL="whisper-1"

# --- Email (magic links, invites) via Resend ---
RESEND_API_KEY=""
EMAIL_FROM="Treename <hello@treename.ai>"

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FAMILY_YEARLY=""   # recurring price, $59 / year
STRIPE_PRICE_LEGACY_GIFT=""     # one-time price, $99
STRIPE_PRICE_FOUNDING=""        # one-time price, $249 (first 500 families)

# --- File storage for audio and photos ---
# On Vercel: create a PRIVATE Blob store (Storage tab) and connect it — Vercel sets BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN automatically; either works.
# Without it, files go to a local folder (development only).
BLOB_READ_WRITE_TOKEN=""
STORAGE_DIR="./storage"

# --- Founder metrics page /app/admin (comma-separated emails) ---
ADMIN_EMAILS=""

# --- Testing only: show sign-in links on screen when email is not configured.
# Never set this in production.
SHOW_LOGIN_LINKS=""

# --- Map tiles for the family map (optional). Default: OpenStreetMap standard tiles.
# For high traffic use a provider with a key, e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILES=""
