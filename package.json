{
  "name": "treename",
  "version": "2.0.0",
  "private": true,
  "description": "Treename 2.0 — family history, told by your family",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/figtree": "^5.2.0",
    "@fontsource/spectral": "^5.2.0",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.8.1",
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
